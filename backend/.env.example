# Leave MONGODB_URI empty to boot a disposable in-memory replica set (zero setup).
# Point it at Atlas or a local mongod to persist data.
MONGODB_URI=
MONGODB_DB_NAME=feedants
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
SEAT_HOLD_SECONDS=600
HOLD_SWEEP_INTERVAL_SECONDS=60
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,hi
